}

model ProductAttributeValue {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  product_attribute_id BigInt    @db.UnsignedBigInt
  value                String    @db.VarChar(255)
  label                String    @db.VarChar(255)
  color_code           String?   @db.VarChar(100)
  sort_order           Int       @default(0)
  created_user_id      BigInt?   @db.UnsignedBigInt
  updated_user_id      BigInt?   @db.UnsignedBigInt
  created_at           DateTime  @default(now()) @db.DateTime(0)
  updated_at           DateTime  @updatedAt @db.DateTime(0)
  deleted_at           DateTime? @db.DateTime(0)

  attribute          ProductAttribute          @relation(fields: [product_attribute_id], references: [id], onDelete: Cascade)
  variant_attributes ProductVariantAttribute[]

  @@index([product_attribute_id], map: "idx_product_attribute_values_attr_id")
  @@map("product_attribute_values")
}

model ProductVariantAttribute {
  id                         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  product_variant_id         BigInt    @db.UnsignedBigInt
  product_attribute_id       BigInt    @db.UnsignedBigInt
  product_attribute_value_id BigInt    @db.UnsignedBigInt
  created_user_id            BigInt?   @db.UnsignedBigInt
  updated_user_id            BigInt?   @db.UnsignedBigInt
  created_at                 DateTime  @default(now()) @db.DateTime(0)
  updated_at                 DateTime  @updatedAt @db.DateTime(0)
  deleted_at                 DateTime? @db.DateTime(0)

  variant         ProductVariant        @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)
  attribute_value ProductAttributeValue @relation(fields: [product_attribute_value_id], references: [id], onDelete: Cascade)

  @@index([product_variant_id], map: "idx_pva_variant_id")
  @@index([product_attribute_id], map: "idx_pva_attribute_id")
  @@index([product_attribute_value_id], map: "idx_pva_value_id")
  @@map("product_variant_attributes")
}

