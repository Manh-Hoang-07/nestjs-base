enum ProductStatus {
  active
  inactive
  draft
  archived
}

model ProductCategory {
  id               BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  name             String      @db.VarChar(255)
  slug             String      @unique @db.VarChar(255)
  description      String?     @db.Text
  parent_id        BigInt?     @db.UnsignedBigInt
  image            String?     @db.VarChar(500)
  icon             String?     @db.VarChar(100)
  status           BasicStatus @default(active)
  sort_order       Int         @default(0)
  meta_title       String?     @db.VarChar(255)
  meta_description String?     @db.Text
  canonical_url    String?     @db.VarChar(500)
  og_image         String?     @db.VarChar(500)
  group_id         BigInt?     @db.UnsignedBigInt // NULL = global category, có giá trị = riêng của group
  created_user_id  BigInt?     @db.UnsignedBigInt
  updated_user_id  BigInt?     @db.UnsignedBigInt
  created_at       DateTime    @default(now()) @db.DateTime(0)
  updated_at       DateTime    @updatedAt @db.DateTime(0)
  deleted_at       DateTime?   @db.DateTime(0)

  parent   ProductCategory?         @relation("ProductCategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children ProductCategory[]        @relation("ProductCategoryHierarchy")
  products ProductProductCategory[]

  @@index([name], map: "idx_product_categories_name")
  @@index([parent_id], map: "idx_product_categories_parent_id")
  @@index([status], map: "idx_product_categories_status")
  @@index([sort_order], map: "idx_product_categories_sort_order")
  @@index([group_id], map: "idx_product_categories_group_id")
  @@index([deleted_at], map: "idx_product_categories_deleted_at")
  @@map("product_categories")
}

model Product {
  id                BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  name              String        @db.VarChar(255)
  slug              String        @unique @db.VarChar(255)
  sku               String        @unique @db.VarChar(100)
  description       String?       @db.LongText
  short_description String?       @db.Text
  min_stock_level   Int           @default(0)
  image             String?       @db.VarChar(500)
  gallery           Json?
  status            ProductStatus @default(active)
  is_featured       Boolean       @default(false)
  is_variable       Boolean       @default(true)
  is_digital        Boolean       @default(false)
  download_limit    Int?
  meta_title        String?       @db.VarChar(255)
  meta_description  String?       @db.Text
  canonical_url     String?       @db.VarChar(500)
  og_title          String?       @db.VarChar(255)
  og_description    String?       @db.Text
  og_image          String?       @db.VarChar(500)
  group_id          BigInt?       @db.UnsignedBigInt
  created_user_id   BigInt?       @db.UnsignedBigInt
  updated_user_id   BigInt?       @db.UnsignedBigInt
  created_at        DateTime      @default(now()) @db.DateTime(0)
  updated_at        DateTime      @updatedAt @db.DateTime(0)
  deleted_at        DateTime?     @db.DateTime(0)

  categories      ProductProductCategory[]
  variants        ProductVariant[]
  reviews         ProductReview[]
  carts           Cart[]
  order_items     OrderItem[]
  inventory       WarehouseInventory[]
  stock_transfers StockTransfer[]

  @@index([name], map: "idx_products_name")
  @@index([status], map: "idx_products_status")
  @@index([is_featured], map: "idx_products_is_featured")
  @@index([group_id], map: "idx_products_group_id")
  @@index([deleted_at], map: "idx_products_deleted_at")
  @@map("products")
}

model ProductProductCategory {
  id                  BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  product_id          BigInt   @db.UnsignedBigInt
  product_category_id BigInt   @db.UnsignedBigInt
  created_at          DateTime @default(now()) @db.DateTime(0)
  updated_at          DateTime @updatedAt @db.DateTime(0)

  product  Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [product_category_id], references: [id], onDelete: Cascade)

  @@unique([product_id, product_category_id], map: "uk_ppc_product_category")
  @@index([product_id], map: "idx_ppc_product_id")
  @@index([product_category_id], map: "idx_ppc_category_id")
  @@map("product_category")
}

model ProductVariant {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  product_id      BigInt    @db.UnsignedBigInt
  name            String    @db.VarChar(255)
  sku             String    @unique @db.VarChar(100)
  price           Decimal   @default(0) @db.Decimal(15, 2)
  sale_price      Decimal?  @db.Decimal(15, 2)
  stock_quantity  Int       @default(0)
  image           String?   @db.VarChar(500)
  is_active       Boolean   @default(true)
  group_id        BigInt?   @db.UnsignedBigInt // Inherit từ product, NULL nếu product global
  created_user_id BigInt?   @db.UnsignedBigInt
  updated_user_id BigInt?   @db.UnsignedBigInt
  created_at      DateTime  @default(now()) @db.DateTime(0)
  updated_at      DateTime  @updatedAt @db.DateTime(0)
  deleted_at      DateTime? @db.DateTime(0)

  product         Product                   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  attributes      ProductVariantAttribute[]
  carts           Cart[]
  order_items     OrderItem[]
  inventory       WarehouseInventory[]
  stock_transfers StockTransfer[]

  @@index([product_id], map: "idx_product_variants_product_id")
  @@index([sku], map: "idx_product_variants_sku")
  @@index([group_id], map: "idx_product_variants_group_id")
  @@map("product_variants")
}

model ProductAttribute {
  id                    BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  name                  String      @db.VarChar(255)
  code                  String      @unique @db.VarChar(100)
