// ============================================
// Ecommerce - Warehouse
// ============================================

model Warehouse {
  id              BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  name            String      @db.VarChar(255)
  code            String      @unique @db.VarChar(100)
  address         String?     @db.Text
  city            String?     @db.VarChar(100)
  district        String?     @db.VarChar(100)
  latitude        Float?      @db.Double
  longitude       Float?      @db.Double
  phone           String?     @db.VarChar(20)
  manager_name    String?     @db.VarChar(255)
  priority        Int         @default(0)
  is_active       Boolean     @default(true)
  contact_name    String?     @db.VarChar(255)
  contact_phone   String?     @db.VarChar(20)
  status          BasicStatus @default(active)
  group_id        BigInt?     @db.UnsignedBigInt // NULL = shared warehouse, có giá trị = riêng của group
  created_user_id BigInt?     @db.UnsignedBigInt
  updated_user_id BigInt?     @db.UnsignedBigInt
  created_at      DateTime    @default(now()) @db.DateTime(0)
  updated_at      DateTime    @updatedAt @db.DateTime(0)
  deleted_at      DateTime?   @db.DateTime(0)

  inventory            WarehouseInventory[]
  stock_transfers_from StockTransfer[]      @relation("FromWarehouse")
  stock_transfers_to   StockTransfer[]      @relation("ToWarehouse")

  @@index([code], map: "idx_warehouses_code")
  @@index([group_id], map: "idx_warehouses_group_id")
  @@map("warehouses")
}

model WarehouseInventory {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  warehouse_id       BigInt   @db.UnsignedBigInt
  product_id         BigInt   @db.UnsignedBigInt
  product_variant_id BigInt?  @db.UnsignedBigInt
  quantity           Int      @default(0)
  min_quantity       Int      @default(0)
  group_id           BigInt?  @db.UnsignedBigInt // Inherit từ warehouse hoặc product
  created_user_id    BigInt?  @db.UnsignedBigInt
  updated_user_id    BigInt?  @db.UnsignedBigInt
  created_at         DateTime @default(now()) @db.DateTime(0)
  updated_at         DateTime @updatedAt @db.DateTime(0)

  warehouse Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [product_variant_id], references: [id], onDelete: SetNull)

  @@unique([warehouse_id, product_id, product_variant_id], map: "uk_warehouse_product_variant")
  @@index([warehouse_id], map: "idx_wi_warehouse_id")
  @@index([product_id], map: "idx_wi_product_id")
  @@index([group_id], map: "idx_wi_group_id")
  @@map("warehouse_inventory")
}

model StockTransfer {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  from_warehouse_id  BigInt?   @db.UnsignedBigInt
  to_warehouse_id    BigInt?   @db.UnsignedBigInt
  product_id         BigInt    @db.UnsignedBigInt
  product_variant_id BigInt?   @db.UnsignedBigInt
  quantity           Int
  type               String    @default("transfer") @db.VarChar(50) // transfer, import, export
  status             String    @default("pending") @db.VarChar(50)
  notes              String?   @db.Text
  group_id           BigInt?   @db.UnsignedBigInt // Inherit từ warehouse hoặc product
  created_user_id    BigInt?   @db.UnsignedBigInt
  updated_user_id    BigInt?   @db.UnsignedBigInt
  created_at         DateTime  @default(now()) @db.DateTime(0)
  updated_at         DateTime  @updatedAt @db.DateTime(0)
  deleted_at         DateTime? @db.DateTime(0)

  @@index([from_warehouse_id], map: "idx_st_from")
  @@index([to_warehouse_id], map: "idx_st_to")
  @@index([product_id], map: "idx_st_product")
  @@index([type], map: "idx_st_type")
  @@index([group_id], map: "idx_st_group_id")
  @@map("stock_transfers")

  from_warehouse   Warehouse?      @relation("FromWarehouse", fields: [from_warehouse_id], references: [id], onDelete: SetNull)
  to_warehouse     Warehouse?      @relation("ToWarehouse", fields: [to_warehouse_id], references: [id], onDelete: SetNull)
  product          Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [product_variant_id], references: [id], onDelete: SetNull)
}

// ============================================
// Ecommerce - Payment & Order (Relations)
